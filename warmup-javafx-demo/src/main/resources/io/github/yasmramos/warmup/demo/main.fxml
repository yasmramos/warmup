<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.yasmramos.warmup.demo.MainController"
      spacing="16" alignment="CENTER" prefWidth="640" prefHeight="420">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    <Label text="Warmup + JavaFX" styleClass="title"/>
    <Label text="Dependency injection, typed views and hot-reload." styleClass="subtitle"/>
    <HBox spacing="8" alignment="CENTER">
        <TextField fx:id="nameField" promptText="Your name"/>
        <Button text="Greet" onAction="#onGreet" defaultButton="true"/>
    </HBox>
    <Label fx:id="greetingLabel" styleClass="greeting"/>
</VBox>
